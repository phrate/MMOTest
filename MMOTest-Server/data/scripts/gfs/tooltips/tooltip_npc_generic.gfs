[client]
[tooltip]

npc_id = ${NPC_ID}
npc_display_name = ${NPC_DISPLAY_NAME}
npc_combat_final_level = ${NPC_COMBAT_FINAL_LEVEL}

actions = [
    if NpcIsBanker():
        bank: "bank/bank_npc.gfs", "Bank `npc_display_name`", {"npc_id"=npc_id}
    if NpcHasDialogue():
        talk: "dialogue/talk_npc.gfs", "Talk to `npc_display_name`", {"npc_id"=npc_id}
    if NpcIsAttackable():
        attack: "combat/combat_start_npc.gfs", "Attack `npc_display_name` (`npc_combat_final_level`)", {"npc_id"=npc_id}
    examine: "examine/examine_npc.gfs", "Examine `npc_display_name`", {"npc_id"=npc_id}
    if PlayerIsAdmin():
        diag_edit: "combat/npc_editor_diag.gfs", "[Admin] Edit `npc_display_name`", {"npc_id"=npc_id}
        diag_kill: "combat/kill_npc_debug.gfs", "[Admin] Kill `npc_display_name`", {"npc_id"=npc_id}
]