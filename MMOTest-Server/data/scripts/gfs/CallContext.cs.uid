using System.Collections.Generic;

namespace MMOTest.Server.Gfs;

/// <summary>
/// Passed to every GFS function.
/// - Effects is the running list the interpreter collects and returns.
///   Functions may append to it (e.g. print_private_to_player targets another peer).
/// - CurrentCall is the CallNode being evaluated, so functions can inspect raw
///   AST arguments (needed for _end_script(follow_player), whose arg is a bare
///   identifier with no runtime value).
/// - ScriptPath is the file path of the currently executing script.
/// </summary>
public sealed class CallContext
{
    public Dictionary<string, object> System { get; set; } = new();
    public Dictionary<string, object> Locals { get; set; } = new();
    public Dictionary<string, object> Args { get; set; } = new();
    public long SelfPlayerId { get; set; }
    public string ScriptPath { get; set; } = "";
    public bool EndScriptRequested { get; set; }
    public CallNode? CurrentCall { get; set; }
    public List<Dictionary<string, object>> Effects { get; } = new();
}