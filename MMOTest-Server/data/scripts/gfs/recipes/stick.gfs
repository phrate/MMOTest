[server]
[recipe]

// DeepSeek note on this script for clarity:
// This uses one item as a tool to turn another item into something else (knife->log->stick)


// Recipe for "Stick"
// Needs items:
// - 1 "Knife" id: item_knife
// - 1 "Log" id: item_log
// Gives:
// - 1 "Stick" id: item_stick

REQUIRE:
	ITEMS:
		item_knife, 1
		item_log, 1

SUCCESS:
	consume = [
		item_log, 1
	]

	output = [
		item_stick, 1
	]

	MESSAGES:
		DEFAULT:
			chat local "You whittle the log..."
			chat local ".. into a stick!"