[server]
[recipe]

// DeepSeek note on this script for clarity:
// This uses two different items to combine them into one new item


// Recipe for "Meat Tray"
// Needs items:
// - 1 "Empty Tray" id: item_tray_empty
// - 2 "Meat" id: item_meat
// Gives:
// - 1 "Meat Tray" id: item_tray_meat

REQUIRE:
	ITEMS:
		item_tray_empty, 1 // slug_id, quantity
		item_meat, 2

// "REQUIRE" is a block that can check for items/item-quantities, levels, quests, etc.
// if it fails, execute everything inside "FAIL" block if there is one
// if it succeeds, execute everything inside "SUCCESS" block

FAIL:
	MESSAGES:
		BAD_QUANTITIES:
			chat local "You do not have enough meat to put on the tray."

SUCCESS:
	consume = [
		item_tray_empty, 1
		item_meat, 2
	]

	output = [
		item_tray_meat, 1
	]

	MESSAGES:
		DEFAULT:
			chat local "You load the tray with meat."